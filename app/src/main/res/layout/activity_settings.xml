<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/title_settings"
        app:titleTextColor="@color/on_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialpadModeHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/settings_dialpad_mode_title"
                android:textColor="@color/on_background"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialpadModeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_dialpad_mode_summary"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/tapModeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_dialpad_mode_title">

                <RadioButton
                    android:id="@+id/rbSingleTap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/mode_single_tap"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="12dp"
                    android:importantForAccessibility="no"
                    android:text="@string/mode_single_tap_description"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbDoubleTap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/mode_double_tap"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="12dp"
                    android:importantForAccessibility="no"
                    android:text="@string/mode_double_tap_description"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbLiftMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/mode_lift_mode"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:importantForAccessibility="no"
                    android:text="@string/mode_lift_mode_description"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAnnounceLetters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/settings_announce_letters_title"
                android:textColor="@color/on_background"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/announceLettersSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_announce_letters_summary"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider" />

            <!-- Call Recording Mode -->
            <TextView
                android:id="@+id/recordingHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/settings_recording_title"
                android:textColor="@color/on_background"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recordingSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_recording_summary"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/recordingModeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_recording_title">

                <RadioButton
                    android:id="@+id/rbRecordingManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/recording_mode_manual"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="10dp"
                    android:importantForAccessibility="no"
                    android:text="@string/recording_mode_manual_desc"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbRecordingAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/recording_mode_auto"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="10dp"
                    android:importantForAccessibility="no"
                    android:text="@string/recording_mode_auto_desc"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider" />

            <!-- Call Recording Quality -->
            <TextView
                android:id="@+id/qualityHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/settings_recording_quality_title"
                android:textColor="@color/on_background"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/recordingQualityRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/settings_recording_quality_title">

                <RadioButton
                    android:id="@+id/rbQualityLow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/recording_quality_low"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbQualityMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/recording_quality_medium"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbQualityHigh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/recording_quality_high"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:id="@+id/updatesHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Updates"
                android:textColor="@color/on_background"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckUpdates"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:minHeight="54dp"
                android:text="Check for Updates"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
